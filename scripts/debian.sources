# Keep both archives at the same snapshot. Advance the date when updating Debian packages.
Types: deb
URIs: http://snapshot.debian.org/archive/debian/@ARCHIVE@/
Suites: bookworm bookworm-updates
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
Check-Valid-Until: no

Types: deb
URIs: http://snapshot.debian.org/archive/debian-security/@SECURITY@/
Suites: bookworm-security
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
Check-Valid-Until: no
